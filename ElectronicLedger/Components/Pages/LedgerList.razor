@page "/"
@rendermode InteractiveServer
@inject LedgerFileService Svc
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 px-2 px-sm-4">

    <!-- ===== タブ ===== -->
    <MudPaper Elevation="2" Square="false" Class="mb-4">
        <MudTabs Elevation="0" Rounded="false" Color="Color.Default"
                 ActivePanelIndexChanged="OnTabChanged">
            <MudTabPanel>
                <TabContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText>販売</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                 Variant="Variant.Filled" Class="my-0">@_salesCount</MudChip>
                    </MudStack>
                </TabContent>
            </MudTabPanel>
            <MudTabPanel>
                <TabContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText>仕入れ</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                 Variant="Variant.Filled" Class="my-0">@_purchaseCount</MudChip>
                    </MudStack>
                </TabContent>
            </MudTabPanel>
        </MudTabs>

        <!-- 件数バー -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"
                  Class="px-4 pb-3" Style="flex-wrap:wrap">
            <MudText Typo="Typo.body2">
                <b style="font-size:18px;color:#1a3a6b">@_counts.Total</b> 件
            </MudText>
            <MudText Typo="Typo.body2" Style="color:#bbb">|</MudText>
            <MudText Typo="Typo.body2">
                <b style="font-size:18px;color:#1e8c45">@_counts.Saved</b> 件 保存済み
            </MudText>
            <MudText Typo="Typo.body2" Style="color:#bbb">|</MudText>
            <MudText Typo="Typo.body2">
                <b style="font-size:18px;color:#c0392b">@_counts.Unsaved</b> 件 未保存
            </MudText>
            @if (_counts.Deleted > 0)
            {
                <MudLink Class="ml-auto" Typo="Typo.caption" Style="color:#aaa"
                         OnClick="ToggleShowDeleted">
                    削除済み @_counts.Deleted 件
                    @(_showDeleted ? "（非表示にする）" : "（表示する）")
                </MudLink>
            }
        </MudStack>
    </MudPaper>

    <!-- ===== ツールバー ===== -->
    <MudStack Row="true" Spacing="2" Class="mb-3" Style="flex-wrap:wrap">
        <MudTextField @bind-Value="_search" Placeholder="🔍 ファイル名・取引先で検索"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Style="min-width:200px;flex:1 1 200px"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" DebounceInterval="300"
                      TextChanged="OnSearchChanged" />
        <MudSelect @bind-Value="_typeFilter" Placeholder="すべての種別"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width:130px"
                   ValueChanged="OnFilterChanged">
            <MudSelectItem Value="@("")">すべての種別</MudSelectItem>
            @foreach (var t in TypesForCategory)
            {
                <MudSelectItem Value="@t">@t</MudSelectItem>
            }
        </MudSelect>
        <MudSelect @bind-Value="_statusFilter" Placeholder="すべてのステータス"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width:150px"
                   ValueChanged="OnFilterChanged">
            <MudSelectItem Value="@("")">すべてのステータス</MudSelectItem>
            <MudSelectItem Value="@("未保存")">未保存</MudSelectItem>
            <MudSelectItem Value="@("保存済み")">保存済み</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Folder"
                   OnClick="OpenFolderSettings">
            フォルダー設定
        </MudButton>
    </MudStack>

    <!-- ===== テーブル（PC） ===== -->
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudPaper Elevation="2">
            <MudTable Items="_files" Hover="true" Dense="true" Striped="false"
                      SortLabel="Sort By" Breakpoint="Breakpoint.None"
                      RowClassFunc="RowClass">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<LedgerFile,object>(x=>x.Name)">ファイル名</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<LedgerFile,object>(x=>x.Type)">種別</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<LedgerFile,object>(x=>x.Counterparty)">取引先</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<LedgerFile,object>(x=>x.Date)" InitialDirection="SortDirection.Descending">日付</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<LedgerFile,object>(x=>x.Amount ?? 0)">金額（税込）</MudTableSortLabel></MudTh>
                    <MudTh>ステータス</MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ファイル名" Style="max-width:220px;word-break:break-all">
                        <b>@context.Name</b>
                        @if (context.Source != null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                     Variant="Variant.Text" Class="ml-1 my-0" Style="font-size:10px">
                                📁 @context.Source
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="種別">@TypeBadge(context)</MudTd>
                    <MudTd DataLabel="取引先">@context.Counterparty</MudTd>
                    <MudTd DataLabel="日付">@context.Date.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="金額" Style="text-align:right">
                        @(context.Amount != null ? "¥" + context.Amount.Value.ToString("N0") : "—")
                    </MudTd>
                    <MudTd DataLabel="ステータス">@StatusChip(context)</MudTd>
                    <MudTd DataLabel="操作">@TableActions(context)</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="pa-6" Style="color:#aaa">
                        該当するファイルがありません
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudHidden>

    <!-- ===== カード（スマホ） ===== -->
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        @if (!_files.Any())
        {
            <MudText Align="Align.Center" Class="pa-6" Style="color:#aaa">
                該当するファイルがありません
            </MudText>
        }
        @foreach (var f in _files)
        {
            <MudCard Class="mb-3 @CardClass(f)" Style="@CardStyle(f)">
                <MudCardContent Class="pb-0">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween">
                        <MudText Style="font-weight:600;word-break:break-all;flex:1">
                            @f.Name
                            @if (f.Source != null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                         Variant="Variant.Text" Class="ml-1 my-0" Style="font-size:10px">
                                    📁 @f.Source
                                </MudChip>
                            }
                        </MudText>
                        <div style="flex-shrink:0">@StatusChip(f)</div>
                    </MudStack>
                    <div class="mt-2 mb-2">@TypeBadge(f)</div>
                    <MudSimpleTable Dense="true" Hover="false" Style="background:transparent">
                        <tbody>
                            <tr>
                                <td style="color:#aaa;font-size:12px;white-space:nowrap;width:60px">取引先</td>
                                <td style="font-size:12px">@f.Counterparty</td>
                            </tr>
                            <tr>
                                <td style="color:#aaa;font-size:12px">日付</td>
                                <td style="font-size:12px">@f.Date.ToString("yyyy-MM-dd")</td>
                            </tr>
                            <tr>
                                <td style="color:#aaa;font-size:12px">金額</td>
                                <td style="font-size:12px">
                                    @(f.Amount != null ? "¥" + f.Amount.Value.ToString("N0") : "—")
                                </td>
                            </tr>
                            @if (f.Status == "保存済み" && f.Pdfs.Any())
                            {
                                <tr>
                                    <td style="color:#aaa;font-size:12px;vertical-align:top">PDF</td>
                                    <td style="font-size:11px">
                                        @foreach (var p in f.Pdfs)
                                        {
                                            <div>📎 @p.FileName <span style="color:#aaa">(@p.SavedAt.ToString("yyyy-MM-dd"))</span></div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudCardContent>
                <MudCardActions Class="justify-end pt-0">
                    @CardActions(f)
                </MudCardActions>
            </MudCard>
        }
    </MudHidden>

</MudContainer>

@code {
    static readonly Dictionary<string, string[]> Types = new()
    {
        ["販売"]  = ["見積書", "注文書", "納品書", "請求書", "その他"],
        ["仕入れ"] = ["見積書", "発注書", "納品書", "請求書", "その他"],
    };

    string _category = "販売";
    string _search = "";
    string _typeFilter = "";
    string _statusFilter = "";
    bool _showDeleted;

    List<LedgerFile> _files = [];
    (int Total, int Saved, int Unsaved, int Deleted) _counts;
    int _salesCount;
    int _purchaseCount;

    string[] TypesForCategory => Types.GetValueOrDefault(_category, []);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _files  = await Svc.GetListAsync(_category, _search, _typeFilter, _statusFilter, _showDeleted);
        _counts = await Svc.GetCountsAsync(_category);
        _salesCount    = await Svc.GetTabCountAsync("販売");
        _purchaseCount = await Svc.GetTabCountAsync("仕入れ");
    }

    async Task OnTabChanged(int idx)
    {
        _category    = idx == 0 ? "販売" : "仕入れ";
        _typeFilter  = "";
        _statusFilter = "";
        await LoadAsync();
    }

    async Task OnSearchChanged(string val) { _search = val; await LoadAsync(); }
    async Task OnFilterChanged(string _)   { await LoadAsync(); }

    async Task ToggleShowDeleted()
    {
        _showDeleted = !_showDeleted;
        await LoadAsync();
    }

    // ===== ダイアログ =====

    async Task OpenEditDialog(LedgerFile f)
    {
        var param = new DialogParameters<EditFileDialog> { { x => x.File, f } };
        var dlg = await DialogService.ShowAsync<EditFileDialog>("ファイル情報を編集", param);
        var result = await dlg.Result;
        if (!result!.Canceled) await LoadAsync();
    }

    async Task OpenPdfDialog(LedgerFile f)
    {
        var param = new DialogParameters<AttachPdfDialog> { { x => x.File, f } };
        var dlg = await DialogService.ShowAsync<AttachPdfDialog>(
            f.Pdfs.Any() ? "PDF を追加" : "PDF を添付して電子帳簿保存", param);
        var result = await dlg.Result;
        if (!result!.Canceled) await LoadAsync();
    }

    async Task OpenDeleteDialog(LedgerFile f)
    {
        var param = new DialogParameters<DeleteConfirmDialog> { { x => x.FileName, f.Name } };
        var dlg = await DialogService.ShowAsync<DeleteConfirmDialog>("一覧から削除", param);
        var result = await dlg.Result;
        if (!result!.Canceled)
        {
            await Svc.SoftDeleteAsync(f.Id);
            Snackbar.Add("🗑️ 一覧から非表示にしました", Severity.Normal);
            await LoadAsync();
        }
    }

    async Task RestoreFile(LedgerFile f)
    {
        await Svc.RestoreAsync(f.Id);
        Snackbar.Add("↩ ファイルを復元しました", Severity.Success);
        await LoadAsync();
    }

    async Task OpenFolderSettings()
    {
        var dlg = await DialogService.ShowAsync<FolderSettingsDialog>("フォルダー設定");
        await dlg.Result;
        await LoadAsync();
    }

    // ===== レンダリングヘルパー =====

    string RowClass(LedgerFile f, int _) => f.Deleted ? "deleted-row" : "";

    string CardClass(LedgerFile f) => f.Deleted ? "deleted-card" : "";

    string CardStyle(LedgerFile f)
    {
        if (f.Deleted) return "border-left:4px solid #d1d5db;opacity:.5";
        return f.Status switch
        {
            "保存済み" => "border-left:4px solid #10b981",
            _         => "border-left:4px solid #ef4444",
        };
    }

    RenderFragment StatusChip(LedgerFile f) => __builder =>
    {
        if (f.Deleted)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Default"
                     Variant="Variant.Filled" Class="my-0">非表示</MudChip>
        }
        else if (f.Status == "保存済み")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success"
                     Variant="Variant.Filled" Class="my-0">保存済み</MudChip>
        }
        else
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error"
                     Variant="Variant.Filled" Class="my-0">未保存</MudChip>
        }
    };

    RenderFragment TypeBadge(LedgerFile f) => __builder =>
    {
        var color = (_category == "販売") ? Color.Success : Color.Warning;
        <MudChip T="string" Size="Size.Small" Color="@color"
                 Variant="Variant.Text" Class="my-0">@f.Type</MudChip>
    };

    RenderFragment TableActions(LedgerFile f) => __builder =>
    {
        if (f.Deleted)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                       OnClick="() => RestoreFile(f)">↩ 復元</MudButton>
        }
        else if (f.Status == "保存済み")
        {
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <div style="font-size:11px;color:#555;line-height:1.6">
                    @foreach (var p in f.Pdfs)
                    {
                        <div>📎 @p.FileName</div>
                    }
                    <div style="color:#aaa;font-size:10px">@f.SavedAt?.ToString("yyyy-MM-dd")</div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small"
                               Color="Color.Primary" Variant="Variant.Outlined"
                               Title="PDF追加" OnClick="() => OpenPdfDialog(f)" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Color="Color.Default" Variant="Variant.Outlined"
                               Title="編集" OnClick="() => OpenEditDialog(f)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" Variant="Variant.Outlined"
                               Title="削除" OnClick="() => OpenDeleteDialog(f)" />
            </MudStack>
        }
        else
        {
            <MudStack Row="true" Spacing="1">
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AttachFile"
                           OnClick="() => OpenPdfDialog(f)">PDF添付</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Color="Color.Default" Variant="Variant.Outlined"
                               OnClick="() => OpenEditDialog(f)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" Variant="Variant.Outlined"
                               OnClick="() => OpenDeleteDialog(f)" />
            </MudStack>
        }
    };

    RenderFragment CardActions(LedgerFile f) => __builder =>
    {
        if (f.Deleted)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                       OnClick="() => RestoreFile(f)">↩ 復元</MudButton>
        }
        else
        {
            var pdfLabel = f.Status == "保存済み" ? "PDF追加" : "PDF添付";
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AttachFile"
                       OnClick="() => OpenPdfDialog(f)">@pdfLabel</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="() => OpenEditDialog(f)">編集</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="() => OpenDeleteDialog(f)">削除</MudButton>
        }
    };
}
