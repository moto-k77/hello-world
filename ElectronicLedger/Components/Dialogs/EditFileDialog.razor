@inject LedgerFileService Svc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">✏️ ファイル情報を編集</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="ファイル名" Value="@File.Name" ReadOnly="true"
                          Variant="Variant.Outlined" />
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudTextField Label="区分" Value="@File.Category" ReadOnly="true"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudSelect Label="種別" @bind-Value="_type" Variant="Variant.Outlined">
                        @foreach (var t in Types.GetValueOrDefault(File.Category, []))
                        {
                            <MudSelectItem Value="@t">@t</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudTextField Label="取引先" @bind-Value="_counterparty"
                          Variant="Variant.Outlined" Placeholder="例: 株式会社サンプル" />
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudDatePicker Label="書類日付" @bind-Date="_date"
                                   Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField Label="金額（税込）" @bind-Value="_amount"
                                     Variant="Variant.Outlined" Min="0"
                                     Format="N0" Placeholder="例: 110000" />
                </MudItem>
            </MudGrid>

            <!-- 添付PDF一覧 -->
            <div>
                <MudText Typo="Typo.caption" Style="font-weight:600;color:#555">添付PDF</MudText>
                <MudPaper Outlined="true" Class="pa-2 mt-1">
                    @if (!File.Pdfs.Any())
                    {
                        <MudText Typo="Typo.caption" Align="Align.Center"
                                 Style="color:#aaa;display:block;padding:8px 0">
                            添付PDFなし
                        </MudText>
                    }
                    @foreach (var pdf in File.Pdfs.ToList())
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="py-1"
                                  Style="border-bottom:1px solid #f0f2f8">
                            <MudText Typo="Typo.body2" Style="flex:1;word-break:break-all">
                                📎 @pdf.FileName
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color:#aaa;white-space:nowrap">
                                @pdf.SavedAt.ToString("yyyy-MM-dd")
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="() => RemovePdf(pdf)" />
                        </MudStack>
                    }
                </MudPaper>
            </div>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">
            保存する
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    static readonly Dictionary<string, string[]> Types = new()
    {
        ["販売"]  = ["見積書", "注文書", "納品書", "請求書", "その他"],
        ["仕入れ"] = ["見積書", "発注書", "納品書", "請求書", "その他"],
    };

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public LedgerFile File { get; set; } = null!;

    string _type = "";
    string _counterparty = "";
    DateTime? _date;
    decimal? _amount;

    protected override void OnParametersSet()
    {
        _type         = File.Type;
        _counterparty = File.Counterparty;
        _date         = File.Date.ToDateTime(TimeOnly.MinValue);
        _amount       = File.Amount;
    }

    async Task RemovePdf(AttachedPdf pdf)
    {
        await Svc.RemovePdfAsync(pdf.Id);
        File.Pdfs.Remove(pdf);
        if (!File.Pdfs.Any())
        {
            File.Status  = "未保存";
            File.SavedAt = null;
        }
        Snackbar.Add("🗑️ PDFを削除しました", Severity.Normal);
        StateHasChanged();
    }

    async Task Submit()
    {
        File.Type         = _type;
        File.Counterparty = _counterparty;
        File.Date         = _date.HasValue ? DateOnly.FromDateTime(_date.Value) : File.Date;
        File.Amount       = _amount;
        await Svc.UpdateAsync(File);
        Snackbar.Add("✅ 情報を更新しました", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    void Cancel() => MudDialog.Cancel();
}
