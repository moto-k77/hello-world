@inject LedgerFileService Svc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">📁 フォルダー設定</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.caption" Style="color:#888">
            取り込み対象のフォルダーを登録します。スキャンするとファイルを一覧に追加します。
        </MudText>

        <!-- フォルダー一覧 -->
        <MudStack Spacing="2" Class="mt-3 mb-4">
            @foreach (var f in _folders)
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Spacing="1">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <div>
                                <MudText Typo="Typo.body1" Style="font-weight:700">
                                    📁 @f.Label
                                </MudText>
                                <MudText Typo="Typo.caption" Style="font-family:monospace;color:#888">
                                    @f.Path
                                </MudText>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="() => DeleteFolder(f)" />
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            @if (f.Category != null)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(f.Category == "販売" ? Color.Success : Color.Warning)"
                                         Variant="Variant.Text" Class="my-0">@f.Category</MudChip>
                            }
                            @if (f.Type != null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                         Variant="Variant.Text" Class="my-0">@f.Type</MudChip>
                            }
                            <MudText Typo="Typo.caption" Style="color:#aaa">
                                @(f.LastScan != null ? "最終スキャン: " + f.LastScan?.ToString("yyyy-MM-dd HH:mm") : "未スキャン")
                            </MudText>
                        </MudStack>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="() => ScanFolder(f)">
                            スキャン
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
            @if (!_folders.Any())
            {
                <MudText Align="Align.Center" Typo="Typo.body2" Style="color:#aaa;padding:16px">
                    フォルダーが登録されていません
                </MudText>
            }
        </MudStack>

        <!-- スキャンログ -->
        @if (_scanLog.Any())
        {
            <MudPaper Class="pa-3 mb-4" Style="background:#1e1e2e;border-radius:8px;font-family:monospace;font-size:12px;max-height:120px;overflow-y:auto">
                @foreach (var (msg, color) in _scanLog)
                {
                    <div style="color:@color;line-height:1.8">@msg</div>
                }
            </MudPaper>
        }

        <!-- フォルダー追加フォーム -->
        <MudPaper Outlined="true" Class="pa-3" Style="border-style:dashed">
            <MudText Typo="Typo.subtitle2" Class="mb-3">＋ フォルダーを追加</MudText>
            <MudStack Spacing="2">
                <MudTextField Label="フォルダー名（表示用）" @bind-Value="_newLabel"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Placeholder="例: 販売請求書フォルダー" />
                <MudTextField Label="フォルダーパス" @bind-Value="_newPath"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Placeholder="例: C:\共有サーバー\販売\請求書" />
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudSelect Label="既定の区分" @bind-Value="_newCategory"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("")">未設定</MudSelectItem>
                            <MudSelectItem Value="@("販売")">販売</MudSelectItem>
                            <MudSelectItem Value="@("仕入れ")">仕入れ</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6">
                        <MudSelect Label="既定の種別" @bind-Value="_newType"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("")">未設定</MudSelectItem>
                            @foreach (var t in TypesForNewCategory)
                            {
                                <MudSelectItem Value="@t">@t</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="AddFolder">フォルダーを追加</MudButton>
            </MudStack>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Close()">閉じる</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="ScanAll">全フォルダーをスキャン</MudButton>
    </DialogActions>
</MudDialog>

@code {
    static readonly Dictionary<string, string[]> Types = new()
    {
        ["販売"]  = ["見積書", "注文書", "納品書", "請求書", "その他"],
        ["仕入れ"] = ["見積書", "発注書", "納品書", "請求書", "その他"],
    };

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    List<FolderSetting> _folders = [];
    List<(string msg, string color)> _scanLog = [];

    string _newLabel = "";
    string _newPath = "";
    string _newCategory = "";
    string _newType = "";

    string[] TypesForNewCategory =>
        string.IsNullOrEmpty(_newCategory) ? [] : Types.GetValueOrDefault(_newCategory, []);

    protected override async Task OnInitializedAsync()
        => _folders = await Svc.GetFoldersAsync();

    async Task AddFolder()
    {
        if (string.IsNullOrWhiteSpace(_newLabel) || string.IsNullOrWhiteSpace(_newPath))
        {
            Snackbar.Add("フォルダー名とパスを入力してください", Severity.Warning);
            return;
        }
        await Svc.AddFolderAsync(new FolderSetting
        {
            Label    = _newLabel,
            Path     = _newPath,
            Category = string.IsNullOrEmpty(_newCategory) ? null : _newCategory,
            Type     = string.IsNullOrEmpty(_newType)     ? null : _newType,
        });
        _newLabel = _newPath = _newCategory = _newType = "";
        _folders = await Svc.GetFoldersAsync();
        Snackbar.Add("📁 フォルダーを追加しました", Severity.Success);
    }

    async Task DeleteFolder(FolderSetting f)
    {
        await Svc.DeleteFolderAsync(f.Id);
        _folders = await Svc.GetFoldersAsync();
        Snackbar.Add("🗑️ フォルダーを削除しました", Severity.Normal);
    }

    async Task ScanFolder(FolderSetting f)
    {
        _scanLog.Clear();
        AddLog($"🔍 スキャン開始: {f.Path}");
        var added = await Svc.ScanFolderAsync(f.Id);
        _folders = await Svc.GetFoldersAsync();
        AddLog(added > 0 ? $"✅ {added}件を一覧に追加" : "ℹ️  新規ファイルは見つかりませんでした",
               added > 0 ? "#a6e3a1" : "#f9e2af");
        Snackbar.Add($"📁 {added}件取り込みました", Severity.Success);
    }

    async Task ScanAll()
    {
        _scanLog.Clear();
        AddLog($"🔄 全フォルダースキャン ({_folders.Count}件)");
        int total = 0;
        foreach (var f in _folders)
        {
            AddLog($"  📁 {f.Label} ...");
            var added = await Svc.ScanFolderAsync(f.Id);
            total += added;
            AddLog($"     → {added}件追加", "#a6e3a1");
        }
        _folders = await Svc.GetFoldersAsync();
        AddLog($"✅ 完了: 合計 {total}件追加", "#a6e3a1");
        Snackbar.Add($"📁 合計 {total}件取り込みました", Severity.Success);
    }

    void AddLog(string msg, string color = "#89dceb")
    {
        _scanLog.Add((msg, color));
        StateHasChanged();
    }
}
