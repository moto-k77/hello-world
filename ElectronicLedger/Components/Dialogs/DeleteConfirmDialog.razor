<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">🗑️ 一覧から削除</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>以下のファイルを一覧から非表示にします。</MudText>
        <MudText><b>ファイル本体は削除されません。</b></MudText>
        <MudPaper Class="pa-3 mt-3" Style="background:#fef9f9;border:1px solid #fecaca">
            <MudText Typo="Typo.body2" Style="word-break:break-all">@FileName</MudText>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Confirm">
            非表示にする
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string FileName { get; set; } = "";

    void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    void Cancel()  => MudDialog.Cancel();
}
