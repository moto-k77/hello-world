@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Color="Color.Dark" Fixed="true" Dense="false" Elevation="4">
        <MudText Typo="Typo.h6" Style="font-weight:700; letter-spacing:.02em">
            📂 電子帳簿保存管理システム
        </MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Style="opacity:.75">山田 太郎</MudText>
    </MudAppBar>

    <MudMainContent Style="padding-top:64px; background:#f5f6fa; min-height:100vh">
        @Body
    </MudMainContent>
</MudLayout>
